    @Override
    public DataResult<List<ReturnMapDTO>> searchReturnMaps(ReturnMapSearchCriteria request) {
        Specification<ReturnMap> spec = Specification.where(ReturnMapCriteria.hasReturnMapCode(request.getReturnMapCode()))
                .and(ReturnMapCriteria.hasBankErrorCode(request.getBankReturnCode()))
                .and(ReturnMapCriteria.hasInstitutionErrorCode(request.getInstitutionErrorCode()));

        List<ReturnMap> returnMapList=returnMapRepository.findAll(spec);
        List<ReturnMapDTO> returnMapDTOList=returnMapMapper.toReturnMapDTOList(returnMapList);
        return new SuccessDataResult<>("Results listed",returnMapDTOList,200);

    }


