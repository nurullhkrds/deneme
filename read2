// returnMapSlice.js
import { createSlice } from '@reduxjs/toolkit';

const returnMapSliceParameterSlice = createSlice({
  name: 'returnMap',
  initialState: {
    list: [],
    spinning: false,
  },
  reducers: {
    setReturnMapList: (state, action) => {
      state.list = action.payload;
    },
    setSpinning: (state, action) => {
      state.spinning = action.payload;
    },
  },
});

export const { setReturnMapList, setSpinning } = returnMapSliceParameterSlice.actions;
export default returnMapSliceParameterSlice.reducer;



