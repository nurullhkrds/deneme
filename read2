
    CoreServiceResultDTO<List<PaymentSubscriberAccountsDTO>> resultDTO = new CoreServiceResultDTO<>();
    List<PaymentSubscriberAccountsDTO> resultList = new ArrayList<>();

    // Parametrelerin hazırlanması
    String[] excludeProductList = null;
    Boolean isGetAll = Boolean.FALSE;

    // Kanal kodu doğrulaması
    if (PYMChannelUtils.isValidChannelCode(i_requestSource.getChannelCode())) {

        // Parametre listesinin alınması
        String[] parameterCodeList = CommonConsts.ParameterCodes.PARAMLIST__DATA_SERVICES__GET_SUBSCRIBER_AND_ACCOUNT_LIST;
        String[] parameterChannelCodeList = new String[]{i_requestSource.getChannelCode()};

        Map<String, List<ChannelParametersDTO>> paramMap = PYMDtoUtils.getCoreChannelParametersInMapForm(
                ServiceLocator.getCoreBillPaymentsService().getChannelParametersByCriteria(parameterCodeList, parameterChannelCodeList));

        // Ürün listesi dışlama
        if (paramMap != null && paramMap.size() > 0) {
            List<ChannelParametersDTO> tempVal = paramMap.get(CommonConsts.ParameterCodes.QUERY_EXCLUDE_PRODUCTS_FOR_GETSUBSACCLIST);
            if (tempVal != null && tempVal.get(0) != null && tempVal.get(0).getParameterValue() != null) {
                excludeProductList = tempVal.get(0).getParameterValue().split(",");
                for (int i = 0; i < excludeProductList.length; i++) {
                    excludeProductList[i] = excludeProductList[i].trim();
                }
            }
        }
    }

    // Sayfalama kontrolü
    if (i_request.getPageNumber() == null || i_request.getPageSize() == null) {
        i_request.setPageNumber(1);
        i_request.setPageSize(2000); // Varsayılan sayfa boyutu
    }
    if (i_request.isGeneralAccount() == null || i_request.isGeneralAccount()) {
        i_request.setGeneralAccount(Boolean.TRUE);
        isGetAll = Boolean.TRUE;
    }

    // Verilerin sorgulanması
    GetSubscriberRecordsWithAccountsTransformer transformerWithGenericAccounts = new GetSubscriberRecordsWithAccountsTransformer(i_request, excludeProductList);
    QuerySupport.dynamicQuery(NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.QUERY_NAME, transformerWithGenericAccounts);
    resultList.addAll(transformerWithGenericAccounts.getSubscriberList());

    if (isGetAll) {
        i_request.setGeneralAccount(Boolean.FALSE);
        GetSubscriberRecordsWithAccountsTransformer transformerWithoutGenericAccounts = new GetSubscriberRecordsWithAccountsTransformer(i_request, excludeProductList);
        QuerySupport.dynamicQuery(NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.QUERY_NAME, transformerWithoutGenericAccounts);
        resultList.addAll(transformerWithoutGenericAccounts.getSubscriberList());
    }

    // Sonuçların işlenmesi
    if (!resultList.isEmpty()) {
        // Talimatları tarihe göre sıralama
        Collections.sort(resultList, new Comparator<PaymentSubscriberAccountsDTO>() {
            @Override
            public int compare(PaymentSubscriberAccountsDTO o1, PaymentSubscriberAccountsDTO o2) {
                return o1.getCreationDate().compareTo(o2.getCreationDate());
            }
        });

        // İlk 8 talimatı alıyoruz
        List<PaymentSubscriberAccountsDTO> limitedResultList = new ArrayList<>();
        for (int i = 0; i < resultList.size() && i < 8; i++) {
            limitedResultList.add(resultList.get(i));
        }

        resultDTO.setStatus(BillPaymentsConsts.RESPONSE_STATUS.SUCCESS);
        resultDTO.setResponseMessage(PYMResponseUtils.createResponseStatusDTO(EnumResponseCodes.SUCCESS.getValue(), null));
        resultDTO.setResult(limitedResultList);
    } else {
        resultDTO.setStatus(BillPaymentsConsts.RESPONSE_STATUS.ERROR);
        resultDTO.setResponseMessage(PYMResponseUtils.createResponseStatusDTO(EnumResponseCodes.AUTO_NO_AUTO_PAYMENT_ORDER_FOUND_FOR_CUSTOMER.getValue(), null));
        resultDTO.setResult(null);
    }

    return resultDTO;
