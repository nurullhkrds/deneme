    @Test
    void doAccounting_WhenProvisionIsSuccessful_ShouldReturnSuccess() {
        // Arrange
        CreateAccountingDTO createAccountingDTO = Mockito.mock(CreateAccountingDTO.class);
        InstitutionChannelPymMethodDTO institutionChannelPymMethodDTO = Mockito.mock(InstitutionChannelPymMethodDTO.class);
        AccountPaymentMethodDetailDTO accountPaymentMethodDetailDTO = Mockito.mock(AccountPaymentMethodDetailDTO.class);

        Mockito.when(createAccountingDTO.getInstitutionChannelPymMethodDTO()).thenReturn(institutionChannelPymMethodDTO);
        Mockito.when(institutionChannelPymMethodDTO.getAccountPaymentMethodDetailDTO()).thenReturn(accountPaymentMethodDetailDTO);

        // Initialize createAccountingDTO with necessary mock data
        MakeProvisionResponse makeProvisionResponse = new MakeProvisionResponse();
        makeProvisionResponse.setSuccess(true);
        makeProvisionResponse.setContractNo(123L);
        Mockito.when(provisionNextService.makeProvision(Mockito.any())).thenReturn(makeProvisionResponse);

        // Act
        CreateAccountingResultDTO result = accountProvisionService.doAccounting(createAccountingDTO);

        // Assert
        assertTrue(result.isSuccess());
        assertEquals(123L, result.getContractNo());
        Mockito.verify(provisionNextService, Mockito.times(1)).makeProvision(Mockito.any(MakeProvisionRequest.class));
        Mockito.verifyNoMoreInteractions(provisionNextService);
    }

    @Test
