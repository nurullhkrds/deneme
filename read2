 @Test
    void doAccounting_WhenProvisionIsSuccessful_ShouldReturnSuccess() {
        // Arrange
        CreateAccountingDTO createAccountingDTO = new CreateAccountingDTO();
        InstitutionChannelPymMethodDTO institutionChannelPymMethodDTO = new InstitutionChannelPymMethodDTO();
        AccountPaymentMethodDetailDTO accountPaymentMethodDetailDTO = new AccountPaymentMethodDetailDTO();

        institutionChannelPymMethodDTO.setAccountPaymentMethodDetailDTO(accountPaymentMethodDetailDTO);
        createAccountingDTO.setInstitutionChannelPymMethodDTO(institutionChannelPymMethodDTO);

        // Initialize mock responses
        MakeProvisionResponse makeProvisionResponse = new MakeProvisionResponse();
        makeProvisionResponse.setSuccess(true);
        makeProvisionResponse.setContractNo(123L);
        Mockito.when(provisionNextService.makeProvision(Mockito.any())).thenReturn(makeProvisionResponse);

        // Act
        CreateAccountingResultDTO result = accountProvisionService.doAccounting(createAccountingDTO);

        // Assert
        assertTrue(result.isSuccess());
        assertEquals(123L, result.getContractNo());
        Mockito.verify(provisionNextService, Mockito.times(1)).makeProvision(Mockito.any());
        Mockito.verifyNoMoreInteractions(provisionNextService);
    }

