function ReturnMapServiceParametersTable() {
  const dispatch = useDispatch();
  const { list, spinning } = useSelector((state) => state.returnMap);
  const [selectedRowKeys, setSelectedRowKeys] = useState([]);

  useEffect(() => {
    dispatch(fetchReturnMapList({}));
  }, [dispatch]);

  const onChange = (selectedRowKeys, selectedRows) => {
    setSelectedRowKeys(selectedRowKeys);
  };

  return (
    <Table
      rowSelection={{
        selectedRowKeys,
        onChange,
      }}
      data={list}
      columns={columns}
      pagination={{ showTotal: false }}
      title={
        <TableHeader
          extra={<TableHeader.GhostButton icon="round-plus" title="Create" />}
        />
      }
      footer={() => (
        <Row>
          <Col xs={24}>
            <p
              style={{
                margin: '0',
                height: '30px',
                lineHeight: '30px',
              }}
            >
              Lorem ipsum dolor sit amet
              <Button size="small" className="right-floated">
                Button 1
              </Button>
            </p>
          </Col>
        </Row>
      )}
      emptyText={() => (
        <>
          Yeni eklemek için
          <Button link="#">tıklayınız.</Button>
        </>
      )}
      onRow={(record, index) => ({
        onClick: () => {
          console.log('onRowClick', record, index);
        },
      })}
    />
  );
}

export default ReturnMapServiceParametersTable;
