export const fetchReturnMapList = createAsyncThunk(
  'returnMap/fetchReturnMapList',
  async (filters, { rejectWithValue }) => {
    const { callApi } = useShellCommunicator(); // or however you get callApi
    try {
      const response = await sendSearchReturnMapRequest(callApi, filters);
      return response.data;
    } catch (error) {
      return rejectWithValue(error.response.data);
    }
  }
);

const returnMapSlice = createSlice({
  name: 'returnMap',
  initialState: {
    list: [],
    spinning: false,
    error: null,
  },
  reducers: {
    setReturnMapList: (state, action) => {
      state.list = action.payload;
    },
    setSpinning: (state, action) => {
      state.spinning = action.payload;
    },
  },
  extraReducers: (builder) => {
    builder
      .addCase(fetchReturnMapList.pending, (state) => {
        state.spinning = true;
      })
      .addCase(fetchReturnMapList.fulfilled, (state, action) => {
        state.spinning = false;
        state.list = action.payload;
      })
      .addCase(fetchReturnMapList.rejected, (state, action) => {
        state.spinning = false;
        state.error = action.payload;
      });
  },
});

export const { setReturnMapList, setSpinning } = returnMapSlice.actions;
export default returnMapSlice.reducer;
