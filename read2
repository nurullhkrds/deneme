	@Override
	public DynamicQueryTransformerDTO prepare() {
		Map<String, Object> params = new HashMap<String, Object>();
		List<String> flagList = new ArrayList<String>();
		
		if( customerNo != null ) {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__CUSTOMER_NO );
			params.put( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__CUSTOMER_NO, customerNo );		
		}
		if( product != null )  {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__PRODUCT );
			params.put( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__PRODUCT, product );
		}
		if( institution != null )  {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__INSTITUTION );
			params.put( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__INSTITUTION, institution );
		}
		if( subscriberNo != null )  {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__SUBSCRIBERNO );
			params.put( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__SUBSCRIBERNO, subscriberNo );
		}
		if( accountNo != null )  {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__ACCOUNTNO );
			params.put( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__ACCOUNTNO, accountNo );
		}
		if( creditCartNumber != null )  {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__CREDITCARDNO );
			params.put( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__CREDITCARDNO, creditCartNumber );
		}
		if( pageNumber != null )  {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__PAGE_NUMBER );
			params.put( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__PAGE_NUMBER, pageNumber );
		}
		if( pageSize != null )  {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__PAGE_SIZE );
			params.put( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__PAGE_SIZE, pageSize );
		}
		if( PYMArrayUtils.isNotEmpty( excludeProductList ) ) {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__EXCLUDE_PRODUCT_LIST );
			params.put( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__EXCLUDE_PRODUCT_LIST, excludeProductList );
		}
		if( generalAccount != null && generalAccount ) {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__GENERAL_ACCOUNT_ACTIVE );
		}
		else {
			flagList.add( NQConsts.PYM_BILLPAYMENTS_GET_SUBSCRIBER_RECORDS_AND_ACCOUNTS.IN__GENERAL_ACCOUNT_DEACTIVE );
		}

		// Create the DynamicQueryTransformerDTO for dynamic query execution.
		DynamicQueryTransformerDTO dto = new DynamicQueryTransformerDTO();
		dto.setMap( params );
		dto.setFlagList( flagList );
		return dto;
	}

	/**
	 * Returns subscriber list with its' own account list as 'PaymentSubscriberAccountsDTO' list object after DB mapping.
	 * @author U0T4526	( Erçin Akçay )
	 * @return
	 */
	public List<PaymentSubscriberAccountsDTO> getSubscriberList() {
		List<PaymentSubscriberAccountsDTO> resultList = new ArrayList<PaymentSubscriberAccountsDTO>();
		Set<String> keySet = subscriberListMap.keySet();
		for( String key : keySet ) {
			resultList.add( subscriberListMap.get( key ) );
		}
		return resultList;
	}

