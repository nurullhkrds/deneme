// ReturnMapServiceParametersTable.js
import React, { useState } from 'react';
import { Table, Button } from 'antd';

const columnsData = [
  {
    title: 'Name',
    dataIndex: 'name',
    key: 'name',
    width: 200,
    resizable: true,
    render: (text) => (
      <a href="#" onClick={(e) => e.preventDefault()}>
        {text}
      </a>
    ),
  },
  {
    title: 'Age',
    dataIndex: 'age',
    key: 'age',
    width: 200,
  },
  {
    title: 'Address',
    dataIndex: 'address',
    key: 'address',
    width: 200,
  },
  {
    title: 'Action',
    key: 'action',
    width: 200,
    render: (text, record) => (
      <Button type="primary" size="small">
        Invite {record.name}
      </Button>
    ),
  },
];

const ReturnMapServiceParametersTable = ({ data }) => {
  const [columns, setColumns] = useState(columnsData);

  return (
    <Table
      rowSelection={{}}
      columns={columns}
      dataSource={data}
      onResize={(event, { element, size, handle }, index) => {
        if (size.width) {
          setColumns((prevColumns) => {
            const nextColumns = [...columns];
            nextColumns[index - 1] = {
              ...nextColumns[index - 1],
              width: size.width,
            };
            return nextColumns;
          });
        }
      }}
    />
  );
};

export default ReturnMapServiceParametersTable;
