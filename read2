import React, { useState } from 'react';
import { useSelector } from 'react-redux';
import { Table, Row, Col, Button } from 'antd';

const columns = [
  {
    title: 'ReturnMap Kodu',
    dataIndex: 'returnMapCode',
    key: 'returnMapCode',
    sortable: true,
  },
  {
    title: 'Kurum Kodu',
    dataIndex: 'institutionReturnCode',
    key: 'institutionReturnCode',
    sortable: true,
  },
  {
    title: 'Kurum Metni',
    dataIndex: 'institutionReturnText',
    key: 'institutionReturnText',
  },
  {
    title: 'Banka Kodu',
    dataIndex: 'bankReturnCode',
    key: 'bankReturnCode',
  },
  {
    title: 'Banka Metni',
    dataIndex: 'bankReturnText',
    key: 'bankReturnText',
  },
  {
    title: 'Hata Türü',
    dataIndex: 'returnType',
    key: 'returnType',
  },
  {
    title: 'Geri Alınabilir',
    dataIndex: 'isReversible',
    key: 'isReversible',
    render: (isReversible) => (isReversible ? 'Evet' : 'Hayır'),
  },
];

function ReturnMapServiceParametersTable() {
  const data = useSelector((state) => state.returnMap.list);
  const [selectedRowKeys, setSelectedRowKeys] = useState([]);

  const onChange = (selectedRowKeys, selectedRows) => {
    setSelectedRowKeys(selectedRowKeys);
  };

  return (
    <Table
      rowSelection={{
        selectedRowKeys: selectedRowKeys,
        onChange: onChange,
      }}
      dataSource={data}
      columns={columns}
      pagination={{ showTotal: false }}
      title={
        <Row>
          <Col span={24}>
            <Button icon="plus">Create</Button>
          </Col>
        </Row>
      }
      footer={() => (
        <Row>
          <Col span={24}>
            <Button size="small" style={{ float: 'right' }}>Button 1</Button>
          </Col>
        </Row>
      )}
      locale={{
        emptyText: (
          <span>
            Yeni eklemek için <Button type="link">tıklayınız.</Button>
          </span>
        ),
      }}
    />
  );
}

export default ReturnMapServiceParametersTable;
