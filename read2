@Test
    void shouldHandleSuccessfulProvision() {
        // Arrange
        CreateAccountingDTO createAccountingDTO = createSampleDTO(); // Create a sample DTO
        CreateAccountingResultDTO expectedDTO = new CreateAccountingResultDTO();
        expectedDTO.setSuccess(true);

        // Mock behavior of dependent services
        when(provisionNextService.makeProvision(any())).thenReturn(new MakeProvisionResponse(true, "12345", new ArrayList<>()));

        // Act
        CreateAccountingResultDTO resultDTO = accountProvisionService.doAccounting(createAccountingDTO);

        // Assert
        assertTrue(resultDTO.isSuccess());
        assertEquals("12345", resultDTO.getContractNo());
        assertEquals(0, resultDTO.getPendingDetailList().size());

        // Verify interactions with mocks
        verify(provisionNextService, times(1)).makeProvision(any());
        verifyNoMoreInteractions(provisionNextService); // Ensure no other method calls to mock
    }

    @Test
    void shouldHandleFailedProvision() {
        // Arrange
        CreateAccountingDTO createAccountingDTO = createSampleDTO();
        CreateAccountingResultDTO expectedDTO = new CreateAccountingResultDTO();
        expectedDTO.setSuccess(false);
        expectedDTO.setError(EnumBillResult.GENERIC_UNKNOWN_ERROR);

        // Mock behavior of dependent services
        when(provisionNextService.makeProvision(any())).thenReturn(new MakeProvisionResponse(false, null, null));

        // Act
        CreateAccountingResultDTO resultDTO = accountProvisionService.doAccounting(createAccountingDTO);

        // Assert
        assertFalse(resultDTO.isSuccess());
        assertEquals(EnumBillResult.GENERIC_UNKNOWN_ERROR, resultDTO.getError());

        // Verify interactions with mocks
        verify(provisionNextService, times(1)).makeProvision(any());
        verifyNoMoreInteractions(provisionNextService); // Ensure no other method calls to mock
    }

    @Test
    void shouldHandleServiceCallException() {
        // Arrange
        CreateAccountingDTO createAccountingDTO = createSampleDTO();
        CreateAccountingResultDTO expectedDTO = new CreateAccountingResultDTO();
        expectedDTO.setSuccess(false);
        expectedDTO.setError(EnumBillResult.GENERIC_UNKNOWN_ERROR);

        // Mock behavior of dependent services to throw an exception
        when(provisionNextService.makeProvision(any())).thenThrow(new ServiceCallException("Service unavailable"));

        // Act
        CreateAccountingResultDTO resultDTO = accountProvisionService.doAccounting(createAccountingDTO);

        // Assert
        assertFalse(resultDTO.isSuccess());
        assertEquals(EnumBillResult.GENERIC_UNKNOWN_ERROR, resultDTO.getError());

        // Verify interactions with mocks
        verify(provisionNextService, times(1)).makeProvision(any());
        verifyNoMoreInteractions(provisionNextService); // Ensure no other method calls to mock
    }

    private CreateAccountingDTO createSampleDTO() {
        // Create a sample DTO for testing purposes
        CreateAccountingDTO dto = new CreateAccountingDTO();
        // Populate with necessary fields for testing
        return dto;
    }
