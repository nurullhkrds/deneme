import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';
import { sendSearchReturnMapRequest } from '../../components/api/returnMapServiceParameter/ReturnMapServiceParametersApi';

export const fetchReturnMapList = createAsyncThunk(
  'returnMap/fetchReturnMapList',
  async (filters, { rejectWithValue }) => {
    const { callApi } = useShellCommunicator(); // veya callApi'yi başka bir şekilde elde ediyorsanız orayı kullanın
    try {
      const response = await sendSearchReturnMapRequest(callApi, filters);
      return response.data;
    } catch (error) {
      return rejectWithValue(error.response.data);
    }
  }
);

const returnMapSlice = createSlice({
  name: 'returnMap',
  initialState: {
    list: [],
    spinning: false,
    error: null,
  },
  reducers: {
    setReturnMapList: (state, action) => {
      state.list = action.payload;
    },
    setSpinning: (state, action) => {
      state.spinning = action.payload;
    },
  },
  extraReducers: (builder) => {
    builder
      .addCase(fetchReturnMapList.pending, (state) => {
        state.spinning = true;
      })
      .addCase(fetchReturnMapList.fulfilled, (state, action) => {
        state.spinning = false;
        state.list = action.payload;
      })
      .addCase(fetchReturnMapList.rejected, (state, action) => {
        state.spinning = false;
        state.error = action.payload;
      });
  },
});

export const { setReturnMapList, setSpinning } = returnMapSlice.actions;
export default returnMapSlice.reducer;


import {
  buildQueryString,
  arrangeExMessageAndThrowEx,
} from "../../../utils/ApiCallUtils";

export const sendSearchReturnMapRequest = async (callApi, filters) => {
  const endpoint = 'returnMaps/search';
  const criteria = filters ?? {};
  const url = buildQueryString(endpoint, criteria);
  try {
    return await callApi({
      method: 'GET',
      endpoint: url,
    });
  } catch (ex) {
    arrangeExMessageAndThrowEx(ex);
  }
};




