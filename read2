 @Test
    void shouldDoAccountingSuccessfully() {
        // Arrange
        CreateAccountingDTO createAccountingDTO = mock(CreateAccountingDTO.class);
        CreateAccountingResultDTO expectedResponse = new CreateAccountingResultDTO();
        MakeProvisionRequest mockRequest = new MakeProvisionRequest();
        MakeProvisionResponse mockResponse = new MakeProvisionResponse();
        mockResponse.setSuccess(true);
        mockResponse.setContractNo("12345");
        when(provisionNextService.makeProvision(any())).thenReturn(mockResponse);
        when(accountingDateUtil.getAvailDate(any(), anyInt())).thenReturn(LocalDate.now());

        // Act
        CreateAccountingResultDTO result = accountProvisionService.doAccounting(createAccountingDTO);

        // Assert
        assertTrue(result.isSuccess());
        assertEquals("12345", result.getContractNo());
        verify(provisionNextService, times(1)).makeProvision(any());
    }

    @Test
    void shouldHandleFailureInProvisionService() {
        // Arrange
        CreateAccountingDTO createAccountingDTO = mock(CreateAccountingDTO.class);
        CreateAccountingResultDTO expectedResponse = new CreateAccountingResultDTO();
        MakeProvisionRequest mockRequest = new MakeProvisionRequest();
        MakeProvisionResponse mockResponse = new MakeProvisionResponse();
        mockResponse.setSuccess(false);
        mockResponse.setErrorCode(500);
        when(provisionNextService.makeProvision(any())).thenReturn(mockResponse);

        // Act
        CreateAccountingResultDTO result = accountProvisionService.doAccounting(createAccountingDTO);

        // Assert
        assertFalse(result.isSuccess());
        assertEquals(EnumBillResult.GENERIC_UNKNOWN_ERROR, result.getError());
        verify(provisionNextService, times(1)).makeProvision(any());
    }

