        assertEquals(EnumBillResult.GENERIC_UNKNOWN_ERROR, resultDTO.getError());
        assertNull(resultDTO.getContractNo());

        // Verify method calls
        verify(provisionNextService, times(1)).makeProvision(any());
    }

