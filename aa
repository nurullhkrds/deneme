 @Test
    void testUpdateReturnMapCodes_NoReturnMaps() {
        when(returnMapRepository.findByReturnMapDefinitionId(1L)).thenReturn(Collections.emptyList());

        returnMapDefinitionService.updateReturnMapCodes(1L, "NEW_CODE", "User1");

        verify(returnMapRepository, never()).save(any());
    }

    @Test
    void testUpdateReturnMapCodes_WithReturnMaps() {
        when(returnMapRepository.findByReturnMapDefinitionId(1L)).thenReturn(List.of(returnMap));

        returnMapDefinitionService.updateReturnMapCodes(1L, "NEW_CODE", "User1");

        assertEquals("NEW_CODE", returnMap.getReturnMapCode());
        assertEquals("User1", returnMap.getUpdatedBy());
        verify(returnMapRepository, times(1)).save(returnMap);
    }
