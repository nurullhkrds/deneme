package com.ykb.payments.bill.transaction.institution.admin.web;

import com.ykb.architecture.micro.error.exception.MicroException;
import com.ykb.payments.bill.transaction.adapter.constant.ResultConstant;
import com.ykb.payments.bill.transaction.adapter.core.utilities.DataResult;
import com.ykb.payments.bill.transaction.institution.admin.mapper.AdminInstitutionMapper;
import com.ykb.payments.bill.transaction.institution.admin.service.intf.AdminInstitutionService;
import com.ykb.payments.bill.transaction.institution.admin.web.dto.create.CreateInstitutionRequestDTO;
import com.ykb.payments.bill.transaction.institution.admin.web.dto.update.UpdateInstitutionRequestDTO;
import com.ykb.payments.bill.transaction.institution.admin.web.request.create.CreateInstitutionRequest;
import com.ykb.payments.bill.transaction.institution.admin.web.request.update.UpdateInstitutionRequest;
import com.ykb.payments.bill.transaction.institution.admin.web.response.InstitutionWebDTO;
import com.ykb.payments.bill.transaction.institution.dto.InstitutionDTO;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;

import java.util.List;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

public class AdminInstitutionControllerTest {

    @InjectMocks
    private AdminInstitutionController adminInstitutionController;

    @Mock
    private AdminInstitutionService institutionService;

    @Mock
    private AdminInstitutionMapper institutionMapper;

    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }

    @Test
    void getAllInstitutions_ShouldReturnListOfInstitutionWebDTO() {
        List<InstitutionDTO> institutionDTOList = List.of(new InstitutionDTO());
        List<InstitutionWebDTO> institutionWebDTOList = List.of(new InstitutionWebDTO());

        when(institutionService.getAllInstitutions()).thenReturn(institutionDTOList);
        when(institutionMapper.toInstitutionWebDTOList(institutionDTOList)).thenReturn(institutionWebDTOList);

        ResponseEntity<DataResult<List<InstitutionWebDTO>>> response = adminInstitutionController.getAllInstitutions();

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(ResultConstant.INSTITUTION_CREATED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionWebDTOList, response.getBody().getData());
        verify(institutionService, times(1)).getAllInstitutions();
        verify(institutionMapper, times(1)).toInstitutionWebDTOList(institutionDTOList);
    }

    @Test
    void getInstitutionById_ShouldReturnInstitutionWebDTO() throws MicroException {
        Long id = 1L;
        InstitutionDTO institutionDTO = new InstitutionDTO();
        InstitutionWebDTO institutionWebDTO = new InstitutionWebDTO();

        when(institutionService.getInstitutionByIdTypeSecond(id)).thenReturn(institutionDTO);
        when(institutionMapper.toInstitutionWebDTO(institutionDTO)).thenReturn(institutionWebDTO);

        ResponseEntity<DataResult<InstitutionWebDTO>> response = adminInstitutionController.getInstitutionById(id);

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(ResultConstant.DATA_RETRIEVED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionWebDTO, response.getBody().getData());
        verify(institutionService, times(1)).getInstitutionByIdTypeSecond(id);
        verify(institutionMapper, times(1)).toInstitutionWebDTO(institutionDTO);
    }

    @Test
    void createInstitution_ShouldReturnCreatedInstitutionWebDTO() throws MicroException {
        CreateInstitutionRequest request = new CreateInstitutionRequest();
        CreateInstitutionRequestDTO requestDTO = new CreateInstitutionRequestDTO();
        InstitutionDTO institutionDTO = new InstitutionDTO();
        InstitutionWebDTO institutionWebDTO = new InstitutionWebDTO();

        when(institutionMapper.toCreateInstitutionRequestDTO(request)).thenReturn(requestDTO);
        when(institutionService.createInstitution(requestDTO)).thenReturn(institutionDTO);
        when(institutionMapper.toInstitutionWebDTO(institutionDTO)).thenReturn(institutionWebDTO);

        ResponseEntity<DataResult<InstitutionWebDTO>> response = adminInstitutionController.createInstitution(request);

        assertNotNull(response);
        assertEquals(HttpStatus.CREATED, response.getStatusCode());
        assertEquals(ResultConstant.INSTITUTION_CREATED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionWebDTO, response.getBody().getData());
        verify(institutionMapper, times(1)).toCreateInstitutionRequestDTO(request);
        verify(institutionService, times(1)).createInstitution(requestDTO);
        verify(institutionMapper, times(1)).toInstitutionWebDTO(institutionDTO);
    }

    @Test
    void updateInstitution_ShouldReturnUpdatedInstitutionWebDTO() throws MicroException {
        UpdateInstitutionRequest request = new UpdateInstitutionRequest();
        UpdateInstitutionRequestDTO requestDTO = new UpdateInstitutionRequestDTO();
        InstitutionDTO institutionDTO = new InstitutionDTO();
        InstitutionWebDTO institutionWebDTO = new InstitutionWebDTO();

        when(institutionMapper.toUpdateInstitutionRequestDTO(request)).thenReturn(requestDTO);
        when(institutionService.updateInstitution(requestDTO)).thenReturn(institutionDTO);
        when(institutionMapper.toInstitutionWebDTO(institutionDTO)).thenReturn(institutionWebDTO);

        ResponseEntity<DataResult<InstitutionWebDTO>> response = adminInstitutionController.updateInstitution(request);

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(ResultConstant.INSTITUTION_UPDATED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionWebDTO, response.getBody().getData());
        verify(institutionMapper, times(1)).toUpdateInstitutionRequestDTO(request);
        verify(institutionService, times(1)).updateInstitution(requestDTO);
        verify(institutionMapper, times(1)).toInstitutionWebDTO(institutionDTO);
    }
}
