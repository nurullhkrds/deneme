SELECT *
FROM (
    SELECT
        CASE
            WHEN URUN IN ('CEPTEL', 'ELEKTRİK', 'SU', 'DOĞALGAZ') THEN URUN
            WHEN 'OTHERS' = 'OTHERS' AND URUN IN ('TELEKOM', 'TAHSİLAT', 'KREDİLER') THEN URUN
            WHEN 'OTHERS' = 'NONE' AND URUN IN ('SİGORTA', 'DBS', 'SGK', 'SPT', 'HAVALE', 'KKNTS', 'TEDANAFRM', 'KOÇFİNANS', 'SSK') THEN URUN
        END AS PRODUCT,
        KURUM AS INSTITUTION,
        ABONENO AS SUBSCRIBER_NO,
        GIRISTARIH AS ENTRY_DATE,
        CASE
            WHEN URUN IN ('CEPTEL', 'ELEKTRİK', 'SU', 'DOĞALGAZ') THEN 'TRUE'
            WHEN 'OTHERS' = 'OTHERS' AND URUN IN ('TELEKOM', 'TAHSİLAT', 'KREDİLER') THEN 'TRUE'
            WHEN 'OTHERS' = 'NONE' AND URUN IN ('SİGORTA', 'DBS', 'SGK', 'SPT', 'HAVALE', 'KKNTS', 'TEDANAFRM', 'KOÇFİNANS', 'SSK') THEN 'FALSE'
            ELSE 'FALSE'
        END AS REVERSIBLE
    FROM
        OTOLIVE.T_OTO_ABONE
    WHERE
        MUSTERINO = '112'
        AND (
            ('OTHERS' IN ('CEPTEL', 'ELEKTRİK', 'SU', 'DOĞALGAZ') AND URUN = 'OTHERS')
            OR ('OTHERS' = 'OTHERS' AND URUN IN ('TELEKOM', 'TAHSİLAT', 'KREDİLER')
            OR ('OTHERS' = 'NONE' AND URUN IN ('SİGORTA', 'DBS', 'SGK', 'SPT', 'HAVALE', 'KKNTS', 'TEDANAFRM', 'KOÇFİNANS', 'SSK'))
        )
        AND STATU = 'A'
    ORDER BY GIRISTARIH ASC
)
WHERE ROWNUM <= 8;
