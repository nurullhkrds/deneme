import React, { useEffect, useRef, useState } from 'react';
import { useDispatch, useSelector } from 'react-redux';
import { Row, Col, Input, Spin, Table, Button, Modal, Form, TextInput, Select } from 'ykb-ui';

import { useShellCommunicator } from 'ykb-shell';
import { sendCopyReturnMapRequest, sendSearchReturnMapRequest, sendcreateReturnMapRequest } from '../../components/api/returnMapServiceParameter/ReturnMapServiceParametersApi';
import { setError, setReturnMapList, setSpinning } from '../../redux/slices/returnMapServiceParameter/returnMapServiceParameterSlice';
import ReturnMapServiceParametersTable from './ReturnMapServiceParametersTable';
import ReturnMapServiceParametersSearch from './ReturnMapServiceParametersSearch';
import { fetchInstitutionsData } from '../../service/ApiService';
import ReturnMapServiceParametersModal from './ReturnMapServiceParemetersModal'
import { set } from 'husky';
const Option = Select.Option;

function ReturnMapServiceParameters() {
  const dispatch = useDispatch();
  const { callApi } = useShellCommunicator(); // Adjust this if needed
  const [modalVisible, setModalVisible] = useState(false);
  const [returnMapCode, setReturnMapCode] = useState("");
  const [institutionReturnCode, setinstitutionReturnCode] = useState("");
  const [institutionReturnText, setinstitutionReturnText] = useState("");
  const [bankReturnCode, setbankReturnCode] = useState("");
  const [bankReturnText, setbankReturnText] = useState("");
  const [returnType, setreturnType] = useState("");
  const [isReversible, setIsReversible] = useState(false);



  //modal 2 
  const selectedData = useSelector((state) => state.returnMap.selectedList);
  const [modalVisible2, setModalVisible2] = useState(false);
  const [returnMapCode2, setReturnMapCode2] = useState("");
  const [institutionReturnCode2, setinstitutionReturnCode2] = useState("");
  const [institutionReturnText2, setinstitutionReturnText2] = useState("");
  const [bankReturnCode2, setbankReturnCode2] = useState("");
  const [bankReturnText2, setbankReturnText2] = useState("");
  const [returnType2, setreturnType2] = useState("");
  const [isReversible2, setIsReversible2] = useState(false);
  const selectedIds = useSelector((state) => state.returnMap.selectedList.map(item => item.id));



  const sendcreateReturnMapRequest = {
    returnMapCode,
    institutionReturnCode,
    institutionReturnText,
    bankReturnCode,
    bankReturnText,
    returnType,
    isReversible
  }
  const copyReturnMapRequest = {

    ids: selectedIds,
    returnMapCode: returnMapCode2,
    institutionReturnCode: institutionReturnCode2,
    institutionReturnText: institutionReturnText2,
    bankReturnCode: bankReturnCode2,
    bankReturnText: bankReturnText2,
    returnType: returnType2,
    isReversible: isReversible2,

  }
  const showModal = () => {
    setModalVisible(true);
  };

  const handleOk = () => {
    setModalVisible(false);
    sendcreateReturnMapRequest(callApi, sendcreateReturnMapRequest).then(
      dispatch(fetchInstitutionsData(callApi, {}))
    )

  };

  const handleCancel = () => {
    setModalVisible(false);
  };


  const handleReturnMapCode = (e) => {
    setReturnMapCode(e.target.value)
  }

  const handleInstitutionReturnCode = (e) => {
    setinstitutionReturnCode(e.target.value)
  }

  const handleInstitutionReturnText = (e) => {
    setinstitutionReturnText(e.target.value)
  }


  const handleBankReturnCode = (e) => {
    setbankReturnCode(e.target.value)
  }

  const handleBankReturnText = (e) => {
    setbankReturnText(e.target.value)
  }

  const handleSelectReturnType = value => {
    console.log('selected', value);
    setreturnType(value);
  };
  const handleSelectReversible = value => {
    console.log('selected', value);
    if (value === "true") {
      setIsReversible(true)
    } else {
      setIsReversible(false)
    }
  };





  //modal2 
  const showModal2 = () => {
    setModalVisible(true);
  };

  const handleOk2 = () => {
    setModalVisible2(false);
    sendCopyReturnMapRequest(callApi, copyReturnMapRequest).then(
      dispatch(fetchInstitutionsData(callApi, {}))
    )

  };

  const handleCancel2 = () => {
    setModalVisible(false);
  };


