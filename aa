ublic class BillPaymentReverseProcessInputTest {

    private BillPaymentReverseProcessInput input;

    @BeforeEach
    public void setUp() {
        input = new BillPaymentReverseProcessInput();
    }

    @Test
    public void testConstructor() {
        // Test edilecek constructor'ın doğru EnumProcessCode'u kullanıp kullanmadığını kontrol edin
        assertEquals(EnumProcessCode.PAYMENT_CANCEL, input.getProcessCode(), "Constructor should initialize with PAYMENT_CANCEL");
    }

    @Test
    public void testSetContractNumber() {
        Long contractNumber = 12345L;
        input.setContractNumber(contractNumber);

        // ProcessDataPackKey.CONTRACT_NO.getKey() değerinin doğru olduğunu varsayıyorum
        assertEquals(contractNumber, input.getDataPack().get(ProcessDataPackKey.CONTRACT_NO.getKey()), "Contract number should be set correctly");
    }

    @Test
    public void testSetBillId() {
        Long billId = 67890L;
        input.setBillId(billId);

        // ProcessDataPackKey.BILL_ID.getKey() değerinin doğru olduğunu varsayıyorum
        assertEquals(billId, input.getDataPack().get(ProcessDataPackKey.BILL_ID.getKey()), "Bill ID should be set correctly");
    }
}
