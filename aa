import { useIntl, useShellCommunicator, withPermission } from "ykb-shell";
import {
  Row,
  Col,
  Button,
  Select,
  Form,
  TextInput,
  Notification,
  Message,
} from "ykb-ui";
import ModalMode from "../../constant/ModalMode";

import {
  sendGetInstServiceParameterRequest,
  sendSearchInstServiceParameterRequest,
  sendSaveInstServiceParameterRequest,
  sendUpdateInstServiceParameterRequest,
  sendGetInstitutionsRequest,
  sendDeleteInstServiceParameterRequest,
} from "../../components/api/instServiceParameter/InstServiceParametersApi";

const SecureButton = withPermission(Button);

const InstServiceParameterDetailModalForm = (props) => {
  const { callApi } = useShellCommunicator();

  const formRef = useRef(null);
  const { i18n } = useIntl();
  const { InstServiceParameterDetailModalFormLocale } = i18n;

  const mode = useSelector(
    (state) => state.instServiceParameter.instServiceParameterDetailModal.mode
  );

  const selectedInstServiceParameterId = useSelector(
    (state) =>
      state.instServiceParameter.instServiceParameterDetailModal
        .selectedInstServiceParameterId
  );

  const [instServParamGroupsData, setInstServParamGroupsData] = useState([]);
  const [institutionsData, setInstitutionsData] = useState([]);

  useEffect(() => {
    debugger
    fetchInstServParamGroupsData();
    fetchInstitutionsData();
  }, []);

  const fetchInstitutionsData = async () => {
    try {
      let institutionsResponse = await sendGetInstitutionsRequest(callApi);
      setInstitutionsData(institutionsResponse);
    } catch (error) {
      console.log("fetchInstitutionsData", error);
    }
  };

  const fetchInstServParamGroupsData = async () => {
    try {
      let instServParamGroupsResponse = await sendSearchInstServiceParameterRequest(callApi);
      const instServParamGroups = prepareInstServParamGroups(instServParamGroupsResponse);
      setInstServParamGroupsData(instServParamGroups);
    } catch (error) {
      console.log("fetchInstServParamGroupsData", error);
    }
  };

  const prepareInstServParamGroups = (instServParams) => {
    let instServParamGroups = [];
    let sortedInstServParams = instServParams?.sort((a, b) => a.id - b.id);
    sortedInstServParams?.map((instServParamGroup) => {
      instServParamGroups.push({
        id: instServParamGroup.id,
        institutionId: instServParamGroup.institutionId,
        parameterGroupCode: instServParamGroup.parameterGroupCode,
        parameterKey: instServParamGroup.parameterKey,
        parameterValue: instServParamGroup.parameterValue,
        description: instServParamGroup.description,
      });
    });
    return instServParamGroups;
  };

  const mapInstitutionsSelectData = (institutions) => {
    let selectData = [];
    institutions?.sort((a, b) => a.id - b.id).map((institutions) => {
      selectData.push({
        value: institutions.id?.toString(),
        label: institutions.name
      });
    });
    return selectData;
  };

  useEffect(() => {
    initFormDataForEntry();
    initFormDataForViewAndEdit();
  }, [mode, selectedInstServiceParameterId]);

  const initFormDataForEntry = async () => {
    const suitableStatus = [ModalMode.ENTRY.toString()];
    if (!suitableStatus.includes(mode)) {
      return;
    }
    if (formRef.current) {
      formRef.current.setFieldsValue({
        id: "",
        institutionId: "",
        parameterGroupCode: "",
        parameterKey: "",
        parameterValue: "",
        description:"",
        isActive: "",
      });
    }
  };

  const mapGetInstServiceParameterResponseToFormData = (instServiceParameterResponse) => {
    try {
      return {
        id: instServiceParameterResponse.id.toString(),
        institutionId: instServiceParameterResponse.institutionId?.toString(),
        parameterKey: instServiceParameterResponse.parameterKey?.toString(),
        parameterGroupCode: instServiceParameterResponse.parameterGroupCode?.toString(),
        parameterValue: instServiceParameterResponse.parameterValue?.toString(),
        description:instServiceParameterResponse.description.toString(),
        isActive: instServiceParameterResponse.isActive?.toString(),
      };
    } catch (error) {
      console.log("mapGetInstServiceParameterResponseToFormData", error);
    }
  };

  const initFormDataForViewAndEdit = async () => {
    const suitableStatus = [
      ModalMode.VIEW.toString(),
      ModalMode.EDIT.toString(),
      ModalMode.DELETE.toString(),
    ];
    if (!suitableStatus.includes(mode)) {
      return;
    }

    if (!selectedInstServiceParameterId) {
      return;
    }

    try {
      props.setSpinning({
        status: true,
        text: "Lütfen Bekleyiniz...",
      });

      let instServiceParameterResponse = await sendGetInstServiceParameterRequest(
        callApi,
        selectedInstServiceParameterId
      );

      const formData = mapGetInstServiceParameterResponseToFormData(instServiceParameterResponse);
      if (formRef.current) {
        formRef.current.setFieldsValue(formData);
      }

      props.setSpinning({
        status: false,
        text: null,
      });
    } catch (ex) {
      props.setSpinning({
        status: false,
        text: null,
      });
      console.log("initFormDataForViewAndEdit", ex.message);
      Notification.error(ex.message, 3);
    }
  };

  const onSubmit = (e) => {
    e.preventDefault();
    formRef.current.validateFields(null, (error, values) => {
      if (!error) {
        if (ModalMode.ENTRY.toString() === mode) {
          onSave(values);
        } else if (ModalMode.EDIT.toString() === mode) {
          onUpdate(values);
        } else if (ModalMode.DELETE.toString() === mode) {
          onDelete(values);
        } else {
          console.log(
            "[InstServiceParameterDetailModalForm] -> (onSubmit) : Unknown Modal Mode !!!"
          );
        }
      }
    });
  };

  const onSave = async (formData) => {
    try {
      props.setSpinning({
        status: true,
        text: "Lütfen Bekleyiniz...",
      });

      const newInstServiceParameter = {
        id: selectedInstServiceParameterId,
        institutionId: formData.institutionId,
        groupCode: formData.parameterGroupCode,
        key: formData.parameterKey,
        value: formData.parameterValue,
        description:formData.description,
        isActive: formData.isActive,
      };

      await sendSaveInstServiceParameterRequest(callApi, newInstServiceParameter);

      props.setSpinning({
        status: false,
        text: null,
      });

      Notification.success(
        InstServiceParameterDetailModalFormLocale.messages.insertSuccessMessage
      );

      props.handleOk();
    } catch (ex) {
      console.log("sendSaveInstServiceParameterRequest", ex.message);
      props.setSpinning({
        status: false,
        text: null,
      });
      Notification.error(ex.message, 3);
      props.handleClose();
    }
  };

  const onUpdate = async (formData) => {
    try {
      props.setSpinning({
        status: true,
        text: "Lütfen Bekleyiniz...",
      });

      const newInstServiceParameter = {
        id: selectedInstServiceParameterId,
        institutionId: formData.institutionId,
        groupCode: formData.parameterGroupCode,
        key: formData.parameterKey,
        value: formData.parameterValue,
        description:formData.description,
        isActive: formData.isActive,
      };

      await sendUpdateInstServiceParameterRequest(callApi, selectedInstServiceParameterId, newInstServiceParameter);

      props.setSpinning({
        status: false,
        text: null,
      });

      Notification.success(
        InstServiceParameterDetailModalFormLocale.messages.updateSuccessMessage
      );

      props.handleOk();
    } catch (ex) {
      console.log("sendUpdateInstServiceParameterRequest", ex.message);
      props.setSpinning({
        status: false,
        text: null,
      });
      Notification.error(ex.message, 3);
      props.handleClose();
    }
  };

  const onDelete = async (formData) => {
    try {
      props.setSpinning({
        status: true,
        text: "Lütfen Bekleyiniz...",
      });

      Message.warning({
        title: 'Uyarı',
        content: InstServiceParameterDetailModalFormLocale.messages.deleteWarningMessage,
        onClose: () => {
          console.log('onClose');
        },
        onOk: () => {
          sendDeleteInstServiceParameterRequest(callApi, selectedInstServiceParameterId);

          props.setSpinning({
            status: true,
            text: "Lütfen Bekleyiniz...",
          });

          Notification.success(
            InstServiceParameterDetailModalFormLocale.messages.deleteSuccessMessage
          );
          props.handleOk();
        },
      });
    } catch (ex) {
      console.log("sendUpdateInstServiceParameterRequest", ex.message);
      props.setSpinning({
        status: false,
        text: null,
      });
      Notification.error(ex.message, 3);
      props.handleClose();
    }

  };



  const renderModalFormFooterButtons = () => {
    const buttonsForEntryOrEdit = (
      <>
        <Button onClick={props.handleClose}>
          {InstServiceParameterDetailModalFormLocale.cancelButton}
        </Button>
        <SecureButton
          onClick={onSubmit}
          type="primary"
          permission="instServiceParameterCancelBtn"
        >
          {InstServiceParameterDetailModalFormLocale.submitButton}
        </SecureButton>
      </>
    );

    if (
      [ModalMode.ENTRY.toString(), ModalMode.EDIT.toString()].includes(mode)
    ) {
      return buttonsForEntryOrEdit;
    } else {
      return <></>;
    }
  };

  const renderDeleteModalFormButton = () => {
    const buttonForDelete = (
      <>
        <Button onClick={props.handleClose}>
          {InstServiceParameterDetailModalFormLocale.cancelButton}
        </Button>
        <Button
          onClick={onSubmit}
          type="danger"
          permission="instServiceParameterCancelBtn"
        >
          {InstServiceParameterDetailModalFormLocale.deleteButton}
        </Button>
      </>
    );

    if (
      [ModalMode.DELETE.toString()].includes(mode)
    ) {
      return buttonForDelete;
    } else {
      return <></>;
    }
  };

  return (
    <React.Fragment>
      <Form ref={formRef}>
        <Form.Item
          label={
            InstServiceParameterDetailModalFormLocale.institutionId
              .label
          }
          colSpan={{ xs: 24, sm: 24, md: 12, lg: 12 }}
        >
          <Select
            name="institutionId"
            data={
              institutionsData &&
              mapInstitutionsSelectData(institutionsData)
            }
            allowClear

            disabled={[
              ModalMode.VIEW.toString(),
              ModalMode.EDIT.toString(),
            ].includes(mode)}
          />
        </Form.Item>
        <Form.Item
          label={InstServiceParameterDetailModalFormLocale.parameterGroupCode.label}
          colSpan={{ xs: 24, sm: 24, md: 12, lg: 12 }}
        >
          <TextInput
            name="parameterGroupCode"
            validation={[{ required: true }]}
            disabled={ModalMode.VIEW.toString() === mode}
            allowClear
          />
        </Form.Item>
        <Form.Item
          label={InstServiceParameterDetailModalFormLocale.parameterKey.label}
          colSpan={{ xs: 24, sm: 24, md: 12, lg: 12 }}
        >
          <TextInput
            name="parameterKey"
            validation={[{ required: true }]}
            disabled={ModalMode.VIEW.toString() === mode}
            allowClear
          />
        </Form.Item>
        <Form.Item
          label={InstServiceParameterDetailModalFormLocale.parameterValue.label}
          colSpan={{ xs: 24, sm: 24, md: 12, lg: 12 }}
        >
          <TextInput
            name="parameterValue"
            validation={[{ required: true }]}
            disabled={ModalMode.VIEW.toString() === mode}
            allowClear
          />
        </Form.Item>
        <Form.Item
          label={InstServiceParameterDetailModalFormLocale.description.label}
          colSpan={{ xs: 24, sm: 24, md: 12, lg: 12 }}
        >
          <TextInput
            name="description"
            validation={[{ required: true }]}
            disabled={ModalMode.VIEW.toString() === mode}
            allowClear
          />
        </Form.Item>
        <Form.Item
          label={InstServiceParameterDetailModalFormLocale.status.label}
          colSpan={{ xs: 24, sm: 24, md: 12, lg: 12 }}
        >
          <Select
            name="isActive"
            allowClear
            validation={[{ required: true }]}
            data={[
              {
                value: "true",
                label:
                  InstServiceParameterDetailModalFormLocale.status.options.active,
              },
              {
                value: "false",
                label:
                  InstServiceParameterDetailModalFormLocale.status.options
                    .passive,
              },
            ]}
          />
        </Form.Item>
        <Form.Item colSpan={{ span: 24 }}>
          <Row>
            <Col>
              <div className="footer pull-right">
                {renderModalFormFooterButtons()}
              </div>
            </Col>
            <Col>
              <div className="footer pull-right">
                {renderDeleteModalFormButton()}
              </div>
            </Col>
          </Row>
        </Form.Item>
      </Form>
    </React.Fragment>
  );
};

InstServiceParameterDetailModalForm.propTypes = {
  handleOk: PropTypes.func.isRequired,
  handleClose: PropTypes.func.isRequired,
  handleDelete: PropTypes.func.isRequired,
  setSpinning: PropTypes.func.isRequired,
};

export default InstServiceParameterDetailModalForm;

