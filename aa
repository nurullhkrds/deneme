public class BillPaymentProcessInputTest {

    private BillPaymentProcessInput billPaymentProcessInput;

    @Mock
    private AccountPaymentMethodDetailDTO accountPaymentMethodDetailDTO;

    @Mock
    private CreditCardPaymentMethodDetailDTO creditCardPaymentMethodDetailDTO;

    @Mock
    private CashPaymentMethodDetailDTO cashPaymentMethodDetailDTO;

    @BeforeEach
    public void setUp() {
        MockitoAnnotations.openMocks(this);
        billPaymentProcessInput = new BillPaymentProcessInput(EnumProcessCode.BILL_PAYMENT);
    }

    @Test
    public void testSetBillProvisionId() {
        Long billProvisionId = 123L;
        billPaymentProcessInput.setBillProvisionId(billProvisionId);
        assertEquals(billProvisionId, billPaymentProcessInput.getDataPack().get(ProcessDataPackKey.BILL_PROVISION_ID.getKey()));
    }

    @Test
    public void testSetPaymentAmount() {
        BigDecimal paymentAmount = BigDecimal.valueOf(100.50);
        billPaymentProcessInput.setPaymentAmount(paymentAmount);
        assertEquals(paymentAmount, billPaymentProcessInput.getDataPack().get(ProcessDataPackKey.PAYMENT_AMOUNT.getKey()));
    }

    @Test
    public void testSetCurrency() {
        String currency = "USD";
        billPaymentProcessInput.setCurrency(currency);
        assertEquals(currency, billPaymentProcessInput.getDataPack().get(ProcessDataPackKey.CURRENCY.getKey()));
    }

    @Test
    public void testSetPaymentMethodType() {
        String paymentMethodType = "CREDIT_CARD";
        billPaymentProcessInput.setPaymentMethodType(paymentMethodType);
        assertEquals(EnumPaymentMethod.valueOf(paymentMethodType), billPaymentProcessInput.getDataPack().get(ProcessDataPackKey.PAYMENT_METHOD_TYPE.getKey()));
    }

    @Test
    public void testSetAccountPaymentMethodDetail() {
        billPaymentProcessInput.setAccountPaymentMethodDetail(accountPaymentMethodDetailDTO);
        assertEquals(accountPaymentMethodDetailDTO, billPaymentProcessInput.getDataPack().get(ProcessDataPackKey.ACCOUNT_PAYMENT_METHOD_DETAIL.getKey()));
    }

    @Test
    public void testSetCreditCardPaymentMethodDetail() {
        billPaymentProcessInput.setCreditCardPaymentMethodDetail(creditCardPaymentMethodDetailDTO);
        assertEquals(creditCardPaymentMethodDetailDTO, billPaymentProcessInput.getDataPack().get(ProcessDataPackKey.CREDIT_CARD_PAYMENT_METHOD_DETAIL.getKey()));
    }

    @Test
    public void testSetCashPaymentMethodDetail() {
        billPaymentProcessInput.setCashPaymentMethodDetail(cashPaymentMethodDetailDTO);
        assertEquals(cashPaymentMethodDetailDTO, billPaymentProcessInput.getDataPack().get(ProcessDataPackKey.CASH_PAYMENT_METHOD_DETAIL.getKey()));
    }
}
