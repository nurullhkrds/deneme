const { Option } = Select;

function ReturnMapServiceParameters() {
  const dispatch = useDispatch();
  const { callApi } = useShellCommunicator(); // Adjust this if needed
  const [modalVisible, setModalVisible] = useState(false);
  const [returnMapCode, setReturnMapCode] = useState('');
  const [institutionReturnCode, setInstitutionReturnCode] = useState('');
  const [institutionReturnText, setInstitutionReturnText] = useState('');
  const [bankReturnCode, setBankReturnCode] = useState('');
  const [bankReturnText, setBankReturnText] = useState('');
  const [returnType, setReturnType] = useState('SUCCESS'); // Default value
  const [isReversible, setIsReversible] = useState(false); // Default value

  const showModal = () => {
    setModalVisible(true);
  };

  const handleOk = () => {
    console.log('Form submitted with values:', {
      returnMapCode,
      institutionReturnCode,
      institutionReturnText,
      bankReturnCode,
      bankReturnText,
      returnType,
      isReversible,
    });
    // Add your API call or form submission logic here
    setModalVisible(false);
  };

  const handleCancel = () => {
    setModalVisible(false);
  };

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    switch (name) {
      case 'returnMapCode':
        setReturnMapCode(value);
        break;
      case 'institutionReturnCode':
        setInstitutionReturnCode(value);
        break;
      case 'institutionReturnText':
        setInstitutionReturnText(value);
        break;
      case 'bankReturnCode':
        setBankReturnCode(value);
        break;
      case 'bankReturnText':
        setBankReturnText(value);
        break;
      default:
        break;
    }
  };

  const handleSelectChange = (value, field) => {
    if (field === 'returnType') {
      setReturnType(value);
    } else if (field === 'isReversible') {
      setIsReversible(value === 'true');
    }
  };

  useEffect(() => {
    dispatch(fetchInstitutionsData(dispatch, callApi, {}));
  }, [dispatch, callApi]);

  return (
    <>
      <Row>
        <Col xs={24} sm={24} md={24} lg={24}>
          <ReturnMapServiceParametersSearch callApi={callApi} />
        </Col>
      </Row>
      <Row>
        <Col xs={24} sm={24} md={24} lg={24}>
          <ReturnMapServiceParametersTable />
        </Col>
      </Row>
      <Row style={{ marginTop: '25px' }}>
        <Col xs={24} sm={24} md={24} lg={24}>
          <Button onClick={showModal}>Ekle</Button>
          <Button>Güncelle</Button>
          <Button>Kopyala</Button>
        </Col>
      </Row>

      <Modal
        title="Add New Return Map"
        visible={modalVisible}
        onCancel={handleCancel}
        footer={[
          <Button key="cancel" onClick={handleCancel}>
            Cancel
          </Button>,
          <Button key="ok" type="primary" onClick={handleOk}>
            Save
          </Button>,
        ]}
      >
        <Form layout="vertical">
          <Form.Item label="Return Map Code">
            <Input
              name="returnMapCode"
              value={returnMapCode}
              onChange={handleInputChange}
            />
          </Form.Item>
          <Form.Item label="Institution Return Code">
            <Input
              name="institutionReturnCode"
              value={institutionReturnCode}
              onChange={handleInputChange}
            />
          </Form.Item>
          <Form.Item label="Institution Return Text">
            <Input
              name="institutionReturnText"
              value={institutionReturnText}
              onChange={handleInputChange}
            />
          </Form.Item>
          <Form.Item label="Bank Return Code">
            <Input
              name="bankReturnCode"
              value={bankReturnCode}
              onChange={handleInputChange}
            />
          </Form.Item>
          <Form.Item label="Bank Return Text">
            <Input
              name="bankReturnText"
              value={bankReturnText}
              onChange={handleInputChange}
            />
          </Form.Item>
          <Form.Item label="Return Type">
            <Select
              value={returnType}
              onChange={(value) => handleSelectChange(value, 'returnType')}
            >
              <Option value="SUCCESS">Success</Option>
              <Option value="ERROR">Error</Option>
            </Select>
          </Form.Item>
          <Form.Item label="Is Reversible">
            <Select
              value={isReversible ? 'true' : 'false'}
              onChange={(value) => handleSelectChange(value, 'isReversible')}
            >
              <Option value="true">True</Option>
              <Option value="false">False</Option>
            </Select>
          </Form.Item>
        </Form>
      </Modal>
    </>
  );
}

export default ReturnMapServiceParameters;
