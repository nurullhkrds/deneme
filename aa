@Test
void testUpdateReturnMapDefinition_WithReturnMaps() throws MicroException {
    UpdateReturnMapDefinitionRequest request = new UpdateReturnMapDefinitionRequest();
    request.setId(1L);
    request.setReturnMapCode("updatedCode");
    request.setIsActive(true);
    request.setUpdateUser("User1");

    ReturnMapDefinition existingReturnMap = new ReturnMapDefinition();
    existingReturnMap.setId(1L);
    existingReturnMap.setReturnMapCode("oldCode");

    ReturnMap returnMap1 = new ReturnMap();
    returnMap1.setReturnMapCode("oldCode");

    ReturnMap returnMap2 = new ReturnMap();
    returnMap2.setReturnMapCode("oldCode");

    when(returnMapDefinitionRepository.findById(request.getId())).thenReturn(Optional.of(existingReturnMap));
    when(returnMapDefinitionRepository.findByReturnMapCode(request.getReturnMapCode())).thenReturn(Optional.empty());
    when(returnMapRepository.findByReturnMapDefinitionId(request.getId())).thenReturn(Arrays.asList(returnMap1, returnMap2));
    when(returnMapDefinitionRepository.save(existingReturnMap)).thenReturn(existingReturnMap);
    when(returnMapDefinitionMapper.toReturnMapDefinitionDTO(existingReturnMap)).thenReturn(new ReturnMapDefinitionDTO());

    DataResult<ReturnMapDefinitionDTO> result = returnMapDefinitionService.updateReturnMapDefinition(request);

    assertTrue(result.isSuccess());
    assertEquals(200, result.getStatusCode());
    assertEquals("updatedCode", returnMap1.getReturnMapCode());
    assertEquals("updatedCode", returnMap2.getReturnMapCode());
    verify(returnMapRepository, times(1)).save(returnMap1);
    verify(returnMapRepository, times(1)).save(returnMap2);
}

