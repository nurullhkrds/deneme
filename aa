package com.ykb.payments.bill.transaction.institution.admin.web;

import com.ykb.architecture.micro.error.exception.MicroException;
import com.ykb.payments.bill.transaction.adapter.constant.ResultConstant;
import com.ykb.payments.bill.transaction.adapter.core.utilities.DataResult;
import com.ykb.payments.bill.transaction.institution.admin.mapper.AdminInstitutionDebtTypeMapper;
import com.ykb.payments.bill.transaction.institution.admin.service.intf.AdminInstitutionDebtTypeService;
import com.ykb.payments.bill.transaction.institution.admin.web.dto.create.CreateInstitutionDebtTypeRequestDTO;
import com.ykb.payments.bill.transaction.institution.admin.web.dto.update.UpdateInstitutionDebtTypeRequestDTO;
import com.ykb.payments.bill.transaction.institution.admin.web.request.create.CreateInstitutionDebtTypeRequest;
import com.ykb.payments.bill.transaction.institution.admin.web.request.update.UpdateInstitutionDebtTypeRequest;
import com.ykb.payments.bill.transaction.institution.admin.web.response.InstitutionDebtTypeWebDTO;
import com.ykb.payments.bill.transaction.institution.dto.InstitutionDebtTypeDTO;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;

import java.util.List;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

public class AdminInstitutionDebtTypeControllerTest {

    @InjectMocks
    private AdminInstitutionDebtTypeController adminInstitutionDebtTypeController;

    @Mock
    private AdminInstitutionDebtTypeService institutionDebtTypeService;

    @Mock
    private AdminInstitutionDebtTypeMapper institutionDebtTypeMapper;

    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }

    @Test
    void getAllInstitutionDebtTypes_ShouldReturnListOfInstitutionDebtTypeWebDTO() {
        List<InstitutionDebtTypeDTO> institutionDebtTypeDTOList = List.of(new InstitutionDebtTypeDTO());
        List<InstitutionDebtTypeWebDTO> institutionDebtTypeWebDTOList = List.of(new InstitutionDebtTypeWebDTO());

        when(institutionDebtTypeService.getAllInstitutionDebtTypes()).thenReturn(institutionDebtTypeDTOList);
        when(institutionDebtTypeMapper.toWebDTOList(institutionDebtTypeDTOList)).thenReturn(institutionDebtTypeWebDTOList);

        ResponseEntity<DataResult<List<InstitutionDebtTypeWebDTO>>> response = adminInstitutionDebtTypeController.getAllInstitutionDebtTypes();

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(ResultConstant.DATA_LISTED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionDebtTypeWebDTOList, response.getBody().getData());
        verify(institutionDebtTypeService, times(1)).getAllInstitutionDebtTypes();
        verify(institutionDebtTypeMapper, times(1)).toWebDTOList(institutionDebtTypeDTOList);
    }

    @Test
    void getInstitutionDebtTypeById_ShouldReturnInstitutionDebtTypeWebDTO() throws MicroException {
        Long id = 1L;
        InstitutionDebtTypeDTO institutionDebtTypeDTO = new InstitutionDebtTypeDTO();
        InstitutionDebtTypeWebDTO institutionDebtTypeWebDTO = new InstitutionDebtTypeWebDTO();

        when(institutionDebtTypeService.getInstitutionDebtTypeById(id)).thenReturn(institutionDebtTypeDTO);
        when(institutionDebtTypeMapper.toWebDTO(institutionDebtTypeDTO)).thenReturn(institutionDebtTypeWebDTO);

        ResponseEntity<DataResult<InstitutionDebtTypeWebDTO>> response = adminInstitutionDebtTypeController.getInstitutionDebtTypeById(id);

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(ResultConstant.DATA_RETRIEVED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionDebtTypeWebDTO, response.getBody().getData());
        verify(institutionDebtTypeService, times(1)).getInstitutionDebtTypeById(id);
        verify(institutionDebtTypeMapper, times(1)).toWebDTO(institutionDebtTypeDTO);
    }

    @Test
    void createInstitutionDebtType_ShouldReturnCreatedInstitutionDebtTypeWebDTO() throws MicroException {
        CreateInstitutionDebtTypeRequest request = new CreateInstitutionDebtTypeRequest();
        CreateInstitutionDebtTypeRequestDTO requestDTO = new CreateInstitutionDebtTypeRequestDTO();
        InstitutionDebtTypeDTO institutionDebtTypeDTO = new InstitutionDebtTypeDTO();
        InstitutionDebtTypeWebDTO institutionDebtTypeWebDTO = new InstitutionDebtTypeWebDTO();

        when(institutionDebtTypeMapper.toCreateInstitutionDebtTypeRequestDTO(request)).thenReturn(requestDTO);
        when(institutionDebtTypeService.createInstitutionDebtType(requestDTO)).thenReturn(institutionDebtTypeDTO);
        when(institutionDebtTypeMapper.toWebDTO(institutionDebtTypeDTO)).thenReturn(institutionDebtTypeWebDTO);

        ResponseEntity<DataResult<InstitutionDebtTypeWebDTO>> response = adminInstitutionDebtTypeController.createInstitutionDebtType(request);

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(ResultConstant.INSTITUTION_DEBT_TYPE_CREATED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionDebtTypeWebDTO, response.getBody().getData());
        verify(institutionDebtTypeMapper, times(1)).toCreateInstitutionDebtTypeRequestDTO(request);
        verify(institutionDebtTypeService, times(1)).createInstitutionDebtType(requestDTO);
        verify(institutionDebtTypeMapper, times(1)).toWebDTO(institutionDebtTypeDTO);
    }

    @Test
    void updateInstitutionDebtType_ShouldReturnUpdatedInstitutionDebtTypeWebDTO() throws MicroException {
        UpdateInstitutionDebtTypeRequest request = new UpdateInstitutionDebtTypeRequest();
        UpdateInstitutionDebtTypeRequestDTO requestDTO = new UpdateInstitutionDebtTypeRequestDTO();
        InstitutionDebtTypeDTO institutionDebtTypeDTO = new InstitutionDebtTypeDTO();
        InstitutionDebtTypeWebDTO institutionDebtTypeWebDTO = new InstitutionDebtTypeWebDTO();

        when(institutionDebtTypeMapper.toUpdateInstitutionDebtTypeRequestDTO(request)).thenReturn(requestDTO);
        when(institutionDebtTypeService.updateInstitutionDebtType(requestDTO)).thenReturn(institutionDebtTypeDTO);
        when(institutionDebtTypeMapper.toWebDTO(institutionDebtTypeDTO)).thenReturn(institutionDebtTypeWebDTO);

        ResponseEntity<DataResult<InstitutionDebtTypeWebDTO>> response = adminInstitutionDebtTypeController.updateInstitutionDebtType(request);

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(ResultConstant.INSTITUTION_DEBT_TYPE_UPDATED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionDebtTypeWebDTO, response.getBody().getData());
        verify(institutionDebtTypeMapper, times(1)).toUpdateInstitutionDebtTypeRequestDTO(request);
        verify(institutionDebtTypeService, times(1)).updateInstitutionDebtType(requestDTO);
        verify(institutionDebtTypeMapper, times(1)).toWebDTO(institutionDebtTypeDTO);
    }
}
