        >

          <div>
            <Form >
              <Form.Item label="ReturnMap Kodu">
                <TextInput
                  name="returnMapCode"
                  value={returnMapCode}
                  onChange={handleReturnMapCode}
                />
              </Form.Item>

              <Form.Item label="Kurum Kodu">
                <TextInput
                  name="institutionReturnCode"
                  value={institutionReturnCode}
                  onChange={handleInstitutionReturnCode}
                />
              </Form.Item>
              <Form.Item label="Kurum Metni">
                <TextInput
                  name="institutionReturnText"
                  value={institutionReturnText}
                  onChange={handleInstitutionReturnText}
                />
              </Form.Item>
              <Form.Item label="Banka Kodu">
                <TextInput
                  name="bankReturnCode"
                  value={bankReturnCode}
                  onChange={handleBankReturnCode}
                />
              </Form.Item>
              <Form.Item label="Banka Metni">
                <TextInput
                  name="bankReturnText"
                  value={bankReturnText}
                  onChange={handleBankReturnText}
                />
              </Form.Item>

              <Form.Item label="Geri Dönüş Tipi">
                <Select onChange={handleSelectReturnType}>
                  <Option value="SUCCESS">
                    Başarılı
                  </Option>
                  <Option value="ERROR" >
                    Başarısız
                  </Option>
                </Select>
              </Form.Item>
              <Form.Item label="Geri Dönüşüm">
                <Select onChange={handleSelectReversible}>

                  <Option value="true" >
                    Geri Döndürülebilir
                  </Option>
                  <Option value="false">Geri Döndürülemez </Option>
                </Select>
              </Form.Item>
            </Form>
          </div>
        </Modal>

      </section>



      {/* ikinci modal */}
      <section>
        <Modal
          title="ReturnMap"
          visible={modalVisible2}
          onClose={handleCancel2}
          footer={[
            <Button key="cancel" onClick={handleCancel2}>
              Cancel
            </Button>,
            <Button key="ok" type="primary" onClick={handleOk2}>
              Save
            </Button>,
          ]}
        >

          <div>
            <Form >
              <Form.Item label="ReturnMap Kodu">
                <TextInput
                  name="returnMapCode2"
                  value={returnMapCode2}
                  onChange={handleReturnMapCode2}
                />
              </Form.Item>

              <Form.Item label="Kurum Kodu">
                <TextInput
                  name="institutionReturnCode2"
                  value={institutionReturnCode2}
                  onChange={handleInstitutionReturnCode2}
                />
              </Form.Item>
              <Form.Item label="Kurum Metni">
                <TextInput
                  name="institutionReturnText2"
                  value={institutionReturnText2}
                  onChange={handleInstitutionReturnText2}
                />
              </Form.Item>
              <Form.Item label="Banka Kodu">
                <TextInput
                  name="bankReturnCode2"
                  value={bankReturnCode2}
                  onChange={handleBankReturnCode2}
                />
              </Form.Item>
              <Form.Item label="Banka Metni">
                <TextInput
                  name="bankReturnText2"
                  value={bankReturnText2}
                  onChange={handleBankReturnText2}
                />
              </Form.Item>

              <Form.Item label="Geri Dönüş Tipi">
                <Select onChange={handleSelectReturnType2}>
                  <Option value="SUCCESS">
                    Başarılı
                  </Option>
                  <Option value="ERROR" >
                    Başarısız
                  </Option>
                </Select>
              </Form.Item>
              <Form.Item label="Geri Dönüşüm">
                <Select onChange={handleSelectReversible2}>

                  <Option value="true" >
                    Geri Döndürülebilir
                  </Option>
                  <Option value="false">Geri Döndürülemez </Option>
                </Select>
              </Form.Item>
            </Form>
          </div>
        </Modal>

      </section>

    </>
  );
}

export default ReturnMapServiceParameters;



