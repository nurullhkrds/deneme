public class CardProvisionServiceImplTest {

    @InjectMocks
    private CardProvisionServiceImpl cardProvisionServiceImpl;

    @Mock
    private SwtSwitchIntegrationService cardProvisionService;

    @Mock
    private ProvisionNextService provisionNextService;

    @Mock
    private AccountingUtilServiceImpl accountingUtilServiceImpl;

    @Mock
    private AccountingUtil accountingDateUtil;

    @BeforeEach
    public void setUp() {
        MockitoAnnotations.openMocks(this);
    }

    @Test
    public void testDoAccountingSuccessRealMerchant() {
        // Create and set up CreateAccountingDTO
        CreateAccountingDTO dto = new CreateAccountingDTO();
        dto.setDummyMerchant(false);
        dto.setPaymentAmount(BigDecimal.valueOf(1000));
        dto.setCurrency(new Currency("USD"));
        dto.setChannelCode("12345");
        dto.setMerchantNo("67890");
        dto.setChannelSessionId("session-id");
        dto.setBranchCode("branch-code");

        // Mock InstitutionDTO
        InstitutionDTO institutionDTO = mock(InstitutionDTO.class);
        when(institutionDTO.getName()).thenReturn("Institution Name");

        // Set InstitutionDTO to CreateAccountingDTO
        dto.setInstitution(institutionDTO);

        // Mock CardProvisionResponse
        CardProvisionResponse cardProvisionResponse = new CardProvisionResponse();
        cardProvisionResponse.setGuid("GUID-12345");
        cardProvisionResponse.setRequestId("12345");

        // Set up mock for cardProvisionService
        when(cardProvisionService.doProvision(any(CardProvisionRequest.class)))
            .thenReturn(cardProvisionResponse);

        // Mock AccountingUtilServiceImpl
        when(accountingUtilServiceImpl.getContractNumber()).thenReturn(123456L);

        // Call the method under test
        CreateAccountingResultDTO result = cardProvisionServiceImpl.doAccounting(dto);

        // Verify results
        assertTrue(result.isSuccess());
        assertEquals(123456L, result.getContractNo());
        assertEquals(12345L, result.getOceanTransactionId());
    }

    @Test
    public void testDoAccountingDummyMerchant() {
        // Create and set up CreateAccountingDTO
        CreateAccountingDTO dto = new CreateAccountingDTO();
        dto.setDummyMerchant(true);
        dto.setPaymentAmount(BigDecimal.valueOf(1000));
        dto.setCurrency(new Currency("USD"));
        dto.setChannelCode("12345");
        dto.setMerchantNo("67890");
        dto.setChannelSessionId("session-id");
        dto.setBranchCode("branch-code");

        // Mock InstitutionDTO
        InstitutionDTO institutionDTO = mock(InstitutionDTO.class);
        when(institutionDTO.getName()).thenReturn("Institution Name");

        // Set InstitutionDTO to CreateAccountingDTO
        dto.setInstitution(institutionDTO);

        // Mock CreateAccountingResultDTO
        CreateAccountingResultDTO createAccountingResultDTO = new CreateAccountingResultDTO();
        createAccountingResultDTO.setSuccess(true);
        createAccountingResultDTO.setOceanTransactionId(12345L);

        // Mock ProvisionNextService
        when(provisionNextService.makeProvision(any(MakeProvisionRequest.class)))
            .thenReturn(new MakeProvisionResponse(true, "Contract-12345"));

        // Call the method under test
        CreateAccountingResultDTO result = cardProvisionServiceImpl.doAccounting(dto);

        // Verify results
        assertTrue(result.isSuccess());
        assertEquals("Contract-12345", result.getContractNo());
    }
}
