   @Transactional
    public Result copyReturnMaps(CopyForIdsAndDataRequest request) {
        try {
            List<ReturnMap> returnMapsToCopy = returnMapRepository.findAllById(request.getIds());
            List<ReturnMap> copiedReturnMaps = new ArrayList<>();

            for (ReturnMap original : returnMapsToCopy) {
                ReturnMap copied = new ReturnMap();

                copied.setReturnMapCode(
                        request.getReturnMapCode() != null ? request.getReturnMapCode() : original.getReturnMapCode()
                );
                copied.setInstitutionReturnCode(
                        request.getInstitutionReturnCode() != null ? request.getInstitutionReturnCode() : original.getInstitutionReturnCode()
                );
                copied.setInstitutionReturnText(
                        request.getInstitutionReturnText() != null ? request.getInstitutionReturnText() : original.getInstitutionReturnText()
                );
                copied.setBankReturnCode(
                        request.getBankReturnCode() != null ? request.getBankReturnCode() : original.getBankReturnCode()
                );
                copied.setBankReturnText(
                        request.getBankReturnText() != null ? request.getBankReturnText() : original.getBankReturnText()
                );
                copied.setReturnType(
                        request.getReturnType() != null ? EnumReturnType.valueOf(request.getReturnType()) : original.getReturnType()
                );

                copied.setIsReversible(
                        request.getIsReversible() != null ? request.getIsReversible() : original.getIsReversible()
                );

                copiedReturnMaps.add(copied);
            }

            returnMapRepository.saveAll(copiedReturnMaps);
            return new SuccessResult("Copy successful", 200);

        } catch (Exception e) {
            return new ErrorResult("Error! " + e.getMessage(), 400);
        }
    }
