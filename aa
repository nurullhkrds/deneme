package com.ykb.payments.bill.transaction.institution.admin.web;

import com.ykb.architecture.micro.error.exception.MicroException;
import com.ykb.payments.bill.transaction.adapter.constant.ResultConstant;
import com.ykb.payments.bill.transaction.adapter.core.utilities.DataResult;
import com.ykb.payments.bill.transaction.institution.admin.mapper.AdminInstitutionFeatureMapper;
import com.ykb.payments.bill.transaction.institution.admin.service.intf.AdminInstitutionFeatureService;
import com.ykb.payments.bill.transaction.institution.admin.web.dto.create.CreateInstitutionFeatureRequestDTO;
import com.ykb.payments.bill.transaction.institution.admin.web.dto.update.UpdateInstitutionFeatureRequestDTO;
import com.ykb.payments.bill.transaction.institution.admin.web.request.create.CreateInstitutionFeatureRequest;
import com.ykb.payments.bill.transaction.institution.admin.web.request.update.UpdateInstitutionFeatureRequest;
import com.ykb.payments.bill.transaction.institution.admin.web.response.InstitutionFeatureWebDTO;
import com.ykb.payments.bill.transaction.institution.dto.InstitutionFeatureDTO;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;

import java.util.List;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

public class AdminInstitutionFeatureControllerTest {

    @InjectMocks
    private AdminInstitutionFeatureController adminInstitutionFeatureController;

    @Mock
    private AdminInstitutionFeatureService institutionFeatureService;

    @Mock
    private AdminInstitutionFeatureMapper institutionFeatureMapper;

    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }

    @Test
    void getAllInstitutionFeatures_ShouldReturnListOfInstitutionFeatureWebDTO() {
        List<InstitutionFeatureDTO> institutionFeatureDTOList = List.of(new InstitutionFeatureDTO());
        List<InstitutionFeatureWebDTO> institutionFeatureWebDTOList = List.of(new InstitutionFeatureWebDTO());

        when(institutionFeatureService.getAllInstitutionFeatures()).thenReturn(institutionFeatureDTOList);
        when(institutionFeatureMapper.toWebDTOList(institutionFeatureDTOList)).thenReturn(institutionFeatureWebDTOList);

        ResponseEntity<DataResult<List<InstitutionFeatureWebDTO>>> response = adminInstitutionFeatureController.getAllInstitutionFeatures();

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(ResultConstant.DATA_LISTED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionFeatureWebDTOList, response.getBody().getData());
        verify(institutionFeatureService, times(1)).getAllInstitutionFeatures();
        verify(institutionFeatureMapper, times(1)).toWebDTOList(institutionFeatureDTOList);
    }

    @Test
    void getInstitutionFeatureById_ShouldReturnInstitutionFeatureWebDTO() throws MicroException {
        Long id = 1L;
        InstitutionFeatureDTO institutionFeatureDTO = new InstitutionFeatureDTO();
        InstitutionFeatureWebDTO institutionFeatureWebDTO = new InstitutionFeatureWebDTO();

        when(institutionFeatureService.getInstitutionFeatureById(id)).thenReturn(institutionFeatureDTO);
        when(institutionFeatureMapper.toWebDTO(institutionFeatureDTO)).thenReturn(institutionFeatureWebDTO);

        ResponseEntity<DataResult<InstitutionFeatureWebDTO>> response = adminInstitutionFeatureController.getInstitutionFeatureById(id);

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(ResultConstant.DATA_RETRIEVED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionFeatureWebDTO, response.getBody().getData());
        verify(institutionFeatureService, times(1)).getInstitutionFeatureById(id);
        verify(institutionFeatureMapper, times(1)).toWebDTO(institutionFeatureDTO);
    }

    @Test
    void createInstitutionFeature_ShouldReturnCreatedInstitutionFeatureWebDTO() throws MicroException {
        CreateInstitutionFeatureRequest request = new CreateInstitutionFeatureRequest();
        CreateInstitutionFeatureRequestDTO requestDTO = new CreateInstitutionFeatureRequestDTO();
        InstitutionFeatureDTO institutionFeatureDTO = new InstitutionFeatureDTO();
        InstitutionFeatureWebDTO institutionFeatureWebDTO = new InstitutionFeatureWebDTO();

        when(institutionFeatureMapper.toCreateInstitutionFeatureRequestDTO(request)).thenReturn(requestDTO);
        when(institutionFeatureService.createInstitutionFeature(requestDTO)).thenReturn(institutionFeatureDTO);
        when(institutionFeatureMapper.toWebDTO(institutionFeatureDTO)).thenReturn(institutionFeatureWebDTO);

        ResponseEntity<DataResult<InstitutionFeatureWebDTO>> response = adminInstitutionFeatureController.createInstitutionFeature(request);

        assertNotNull(response);
        assertEquals(HttpStatus.CREATED, response.getStatusCode());
        assertEquals(ResultConstant.INSTITUTION_FEATURE_CREATED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionFeatureWebDTO, response.getBody().getData());
        verify(institutionFeatureMapper, times(1)).toCreateInstitutionFeatureRequestDTO(request);
        verify(institutionFeatureService, times(1)).createInstitutionFeature(requestDTO);
        verify(institutionFeatureMapper, times(1)).toWebDTO(institutionFeatureDTO);
    }

    @Test
    void updateInstitutionFeature_ShouldReturnUpdatedInstitutionFeatureWebDTO() throws MicroException {
        UpdateInstitutionFeatureRequest request = new UpdateInstitutionFeatureRequest();
        UpdateInstitutionFeatureRequestDTO requestDTO = new UpdateInstitutionFeatureRequestDTO();
        InstitutionFeatureDTO institutionFeatureDTO = new InstitutionFeatureDTO();
        InstitutionFeatureWebDTO institutionFeatureWebDTO = new InstitutionFeatureWebDTO();

        when(institutionFeatureMapper.toUpdateInstitutionFeatureRequestDTO(request)).thenReturn(requestDTO);
        when(institutionFeatureService.updateInstitutionFeature(requestDTO)).thenReturn(institutionFeatureDTO);
        when(institutionFeatureMapper.toWebDTO(institutionFeatureDTO)).thenReturn(institutionFeatureWebDTO);

        ResponseEntity<DataResult<InstitutionFeatureWebDTO>> response = adminInstitutionFeatureController.updateInstitutionFeature(request);

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(ResultConstant.INSTITUTION_FEATURE_UPDATED.getMessage(), response.getBody().getMessage());
        assertEquals(institutionFeatureWebDTO, response.getBody().getData());
        verify(institutionFeatureMapper, times(1)).toUpdateInstitutionFeatureRequestDTO(request);
        verify(institutionFeatureService, times(1)).updateInstitutionFeature(requestDTO);
        verify(institutionFeatureMapper, times(1)).toWebDTO(institutionFeatureDTO);
    }
}
