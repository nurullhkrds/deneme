<Modal
        title="Add New Return Map"
        visible={modalVisible}
        onClose={handleCancel}
        footer={[
          <Button key="cancel" onClick={handleCancel}>
            Cancel
          </Button>,
          <Button key="ok" type="primary" onClick={handleOk}>
            Save
          </Button>,
        ]}
      >
        <Form layout="vertical">
          <Form.Item label="Return Map Code">
            <Input
              name="returnMapCode"
              value={formValues.returnMapCode}
              onChange={handleInputChange}
            />
          </Form.Item>
          <Form.Item label="Institution Return Code">
            <Input
              name="institutionReturnCode"
              value={formValues.institutionReturnCode}
              onChange={handleInputChange}
            />
          </Form.Item>
          <Form.Item label="Institution Return Text">
            <Input
              name="institutionReturnText"
              value={formValues.institutionReturnText}
              onChange={handleInputChange}
            />
          </Form.Item>
          <Form.Item label="Bank Return Code">
            <Input
              name="bankReturnCode"
              value={formValues.bankReturnCode}
              onChange={handleInputChange}
            />
          </Form.Item>
          <Form.Item label="Bank Return Text">
            <Input
              name="bankReturnText"
              value={formValues.bankReturnText}
              onChange={handleInputChange}
            />
          </Form.Item>
          <Form.Item label="Return Type">
            <Select
              value={formValues.returnType}
              onChange={(value) => handleSelectChange(value, 'returnType')}
            >
              <Option value="ERROR">Error</Option>
              <Option value="SUCCESS">Success</Option>
            </Select>
          </Form.Item>
          <Form.Item label="Is Reversible">
            <Select
              value={formValues.isReversible ? "true" : "false"}
              onChange={(value) => handleSelectChange(value === "true", 'isReversible')}
            >
              <Option value="true">True</Option>
              <Option value="false">False</Option>
            </Select>
          </Form.Item>
        </Form>
      </Modal>


  const [modalVisible, setModalVisible] = useState(false);
  const [formValues, setFormValues] = useState({
    returnMapCode: '',
    institutionReturnCode: '',
    institutionReturnText: '',
    bankReturnCode: '',
    bankReturnText: '',
    returnType: 'SUCCESS', // Default value
    isReversible: true, // Default value
  });

  const showModal = () => {
    setModalVisible(true);
  };

  const handleOk = () => {
    // Handle form submission
    console.log("Form submitted with values:", formValues);
    setModalVisible(false);
  };

  const handleCancel = () => {
    setModalVisible(false);
  };

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setFormValues((prevValues) => ({
      ...prevValues,
      [name]: value,
    }));
  };

  const handleSelectChange = (value, field) => {
    setFormValues((prevValues) => ({
      ...prevValues,
      [field]: value,
    }));
  };
