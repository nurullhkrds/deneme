const handleOk = () => {
    setModalVisible(false);
    sendCreateReturnMapRequest(callApi, {
      returnMapCode,
      institutionReturnCode,
      institutionReturnText,
      bankReturnCode,
      bankReturnText,
      returnType,
      isReversible
    }).then(() => {
      dispatch(fetchInstitutionsData(callApi, {}));
    }).catch(err => {
      console.error("Error creating return map:", err);
    });
  };

